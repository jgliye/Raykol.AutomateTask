<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">
  <variable name="layoutVal" value="${longdate}|${uppercase:${level}}|${message}${newline}${exception}" />

  <targets>
    <!-- 按本机年月写入 EXE 根目录，超过 10 MB 后递增分卷，保留 30 天 -->
    <target name="file" xsi:type="File"
            fileName="${basedir}/Logs/${date:format=yyyy-MM}.log"
            layout="${var:layoutVal}"
            encoding="utf-8"
            archiveAboveSize="10485760"
            archiveSuffixFormat="_{0:000}"
            maxArchiveDays="30"
            keepFileOpen="true"
            autoFlush="true" />
  </targets>

  <rules>
    <!-- 仅记录受控业务日志，避免 HTTP 请求与认证内容进入日志 -->
    <logger name="Raykol.AutomateTask.*" minlevel="Info" writeTo="file" />
  </rules>
</nlog>
