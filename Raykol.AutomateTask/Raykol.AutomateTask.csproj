<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Raykol.AutomateTask</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyTitle>自动化任务</AssemblyTitle>
    <Product>自动化任务</Product>
    <Company>Raykol</Company>
    <Description>本机工时管理与工作日每日汇报服务</Description>
    <ApplicationIcon>Assets\Logo.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FreeSql.Provider.Sqlite" Version="3.5.311" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.11" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Update="NLog.config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Remove="ClientApp\**" />
    <Content Remove="AutomateTask.db*" />
    <None Update="AutomateTask.db*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Remove="ClientApp\**" />
    <None Include="ClientApp\**" Exclude="ClientApp\node_modules\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="RestoreClientApp"
          Inputs="$(MSBuildProjectDirectory)\ClientApp\package.json;$(MSBuildProjectDirectory)\ClientApp\package-lock.json"
          Outputs="$(MSBuildProjectDirectory)\ClientApp\node_modules\.package-lock.json"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" Command="npm ci --no-fund" />
  </Target>
  <Target Name="BuildClientApp" BeforeTargets="AssignTargetPaths" DependsOnTargets="RestoreClientApp"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <Content Remove="wwwroot\**" />
    </ItemGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" Command="npm run build" />
    <ItemGroup>
      <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
