root = true

[*.cs]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

# 这两处采用内联正则，关闭源码生成的性能建议
[Raykol.AutomateTask/{Models/WorkHoursConfig,Services/WorkHoursService}.cs]
dotnet_diagnostic.SYSLIB1045.severity = none

[*.ps1]
charset = utf-8-bom
end_of_line = crlf
